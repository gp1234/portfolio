---
import "../styles/main.css"
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Giovanni Poveda Portfolio</title>
  </head>

  <body id="body">
    <!-- 3D Sphere Background -->
    <div id="sphere-container"></div>

    <div class="content">
      <nav>
        <ol>
          <li>
            <a
              href="https://github.com/gp1234"
              target="_blank"
              rel="noopener noreferrer"
            >
              Github
            </a>
          </li>

          <li>
            <a
              href="https://www.linkedin.com/in/giovanni-poveda/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Linkedin
            </a>
          </li>

          <li>
            <a
              href="https://medium.com/@giovannipoveda51"
              target="_blank"
              rel="noopener noreferrer"
            >
              Medium
            </a>
          </li>

          <li>
            <a href="/blog">Blog</a>
          </li>
        </ol>
      </nav>

      <section class="hero">
        <h1 class="hero_content">
          <span class="word">Hey</span>
          <span class="word">I</span>
          <span class="word">am</span>
          <span class="word word--hightlight">Giovanni</span>
          <span class="word">a</span>

          <div class="attributes">
            <span class="attributes-elements">Software Engineer</span>
            <span class="attributes-elements">Blogger</span>
            <span class="attributes-elements">Designer</span>
            <span class="attributes-elements">AI Student</span>
          </div>
        </h1>
      </section>
    </div>

    <!-- Client-side TypeScript -->
    <script type="module" src="/src/scripts/main.ts"></script>
  </body>
</html>
